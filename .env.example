# 复制本文件为 .env 后填写；.env 已在 .gitignore 中，不会被提交。
# 若全部留空，程序自动降级为 mock 模式（仅走流程，不证明模型决策能力）。

# ---- 模型接入 ----
# deepseek：调用真实模型 | mock：离线脚本 | auto：检测到 Key 就用真实模型，否则降级 mock
LLM_PROVIDER=auto

# DeepSeek API Key（不要带引号，不要提交真实值）
DEEPSEEK_API_KEY=

# OpenAI 兼容地址，DeepSeek 官方为 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 官方 API 的现行模型标识（2026-10 起）
#   deepseek-flash   -> DeepSeek-V4.1-Flash-1017（本栏目默认，也是本项目验证所用模型）
#   deepseek-v4-pro  -> DeepSeek-V4-Pro-0813
# 已退役、不要再用：deepseek-chat / deepseek-reasoner / deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-flash

# 思考模式开关：disabled | low | high | max
# V4.1-Flash 默认是开启的。开启时思维链会占用 max_tokens，可能把 JSON 挤到被截断，
# 表现为返回空内容。本项目只需要几十 token 的结构化动作，请保持 disabled。
DEEPSEEK_THINKING=disabled

LLM_TIMEOUT_SEC=30
LLM_MAX_TOKENS=1024

# ---- Agent 运行边界 ----
# 达到上限时返回明确的未完成状态，而不是伪装成功
MAX_STEPS=8
MAX_TOOL_CALLS=20

# ---- 故障注入开关（用于复现异常场景，不需要改代码）----
# none | save_draft | query_slots
FAIL_INJECTION=none
